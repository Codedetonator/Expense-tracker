<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/bg_gradient_purple"
    android:gravity="center_vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_text_total_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_total_money"
            android:textColor="#DAD6FF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_text_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹0"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_text_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Spent today: ₹0"
            android:textColor="#DAD6FF"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_btn_add"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="12dp"
        android:background="@drawable/bg_pill_glass"
        android:src="@drawable/ic_add"
        android:tint="#FFFFFF"
        android:contentDescription="@string/add_expense_fab" />

</LinearLayout>
